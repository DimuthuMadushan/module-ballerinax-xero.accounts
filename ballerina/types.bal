public type TaxBreakdownComponent record {
    # The amount that is exempt
    @jsondata:Name {value: "ExemptAmount"}
    decimal exemptAmount?;
    # Name identifying the region within the country
    @jsondata:Name {value: "JurisdictionRegion"}
    string jurisdictionRegion?;
    # The type of the jurisdiction
    @jsondata:Name {value: "Type"}
    "SYSGST/USCOUNTRY"|"SYSGST/USSTATE"|"SYSGST/USCOUNTY"|"SYSGST/USCITY"|"SYSGST/USSPECIAL" 'type?;
    # The amount of the tax
    @jsondata:Name {value: "TaxAmount"}
    decimal taxAmount?;
    # The percentage of the tax
    @jsondata:Name {value: "TaxPercentage"}
    decimal taxPercentage?;
    # The amount that is taxable
    @jsondata:Name {value: "TaxableAmount"}
    decimal taxableAmount?;
    # The unique ID number of this component
    @jsondata:Name {value: "TaxComponentId"}
    string taxComponentId?;
    # The state assigned number of the jurisdiction
    @jsondata:Name {value: "StateAssignedNo"}
    string stateAssignedNo?;
    # The amount that is not taxable
    @jsondata:Name {value: "NonTaxableAmount"}
    decimal nonTaxableAmount?;
    # The name of the jurisdiction
    @jsondata:Name {value: "Name"}
    string name?;
};

