public type RepeatingInvoice record {
    # One of the following - DRAFT or AUTHORISED – See Invoice Status Codes
    @jsondata:Name {value: "Status"}
    "DRAFT"|"AUTHORISED"|"DELETED" status?;
    # See LineItems
    @jsondata:Name {value: "LineItems"}
    LineItem[] lineItems?;
    # See BrandingThemes
    @jsondata:Name {value: "BrandingThemeID"}
    string brandingThemeID?;
    # ACCREC only – additional reference number
    @jsondata:Name {value: "Reference"}
    string reference?;
    # Boolean to indicate if an invoice has an attachment
    @jsondata:Name {value: "HasAttachments"}
    boolean hasAttachments = false;
    # Boolean to indicate whether the invoice has been approved for sending
    @jsondata:Name {value: "ApprovedForSending"}
    boolean approvedForSending = false;
    # Total of invoice excluding taxes
    @jsondata:Name {value: "SubTotal"}
    decimal subTotal?;
    # Displays array of attachments from the API
    @jsondata:Name {value: "Attachments"}
    Attachment[] attachments?;
    # Contact associated with the repeating invoice template
    @jsondata:Name {value: "Contact"}
    Contact contact?;
    # Whether line amounts of the repeating invoice template are tax exclusive, tax inclusive or have no tax
    @jsondata:Name {value: "LineAmountTypes"}
    LineAmountTypes lineAmountTypes?;
    # Boolean to indicate whether to include PDF attachment
    @jsondata:Name {value: "IncludePDF"}
    boolean includePDF = false;
    # Currency code of the repeating invoice template
    @jsondata:Name {value: "CurrencyCode"}
    CurrencyCode currencyCode?;
    # Boolean to indicate whether a copy is sent to sender's email
    @jsondata:Name {value: "SendCopy"}
    boolean sendCopy = false;
    # See Invoice Types
    @jsondata:Name {value: "Type"}
    "ACCPAY"|"ACCREC" 'type?;
    # Total tax on invoice
    @jsondata:Name {value: "TotalTax"}
    decimal totalTax?;
    # Schedule on which the repeating invoice is created
    @jsondata:Name {value: "Schedule"}
    Schedule schedule?;
    # Total of Invoice tax inclusive (i.e. SubTotal + TotalTax)
    @jsondata:Name {value: "Total"}
    decimal total?;
    # Xero generated unique identifier for repeating invoice template
    @jsondata:Name {value: "RepeatingInvoiceID"}
    string repeatingInvoiceID?;
    # Xero generated unique identifier for repeating invoice template
    @jsondata:Name {value: "ID"}
    string iD?;
    # Boolean to indicate whether the invoice in the Xero app displays as "sent"
    @jsondata:Name {value: "MarkAsSent"}
    boolean markAsSent = false;
};

