public type Contact record {
    # The default discount rate for the contact (read only)
    @jsondata:Name {value: "Discount"}
    decimal discount?;
    # UTC timestamp of last update to contact
    @jsondata:Name {value: "UpdatedDateUTC"}
    string updatedDateUTC?;
    # Displays validation errors returned from the API
    @jsondata:Name {value: "ValidationErrors"}
    ValidationError[] validationErrors?;
    # The default purchases line amount type for a contact Only available when summaryOnly parameter or paging is used, or when fetch by ContactId or ContactNumber
    @jsondata:Name {value: "PurchasesDefaultLineAmountType"}
    "INCLUSIVE"|"EXCLUSIVE"|"NONE" purchasesDefaultLineAmountType?;
    # Website address for contact (read only)
    @jsondata:Name {value: "Website"}
    string website?;
    # Default payment terms of the contact
    @jsondata:Name {value: "PaymentTerms"}
    PaymentTerm paymentTerms?;
    # Displays array of attachments from the API
    @jsondata:Name {value: "Attachments"}
    Attachment[] attachments?;
    # The default sales line amount type for a contact. Only available when summaryOnly parameter or paging is used, or when fetch by ContactId or ContactNumber
    @jsondata:Name {value: "SalesDefaultLineAmountType"}
    "INCLUSIVE"|"EXCLUSIVE"|"NONE" salesDefaultLineAmountType?;
    # Full name of contact/organisation (max length = 255)
    @jsondata:Name {value: "Name"}
    string name?;
    # The default sales tracking categories for contacts
    @jsondata:Name {value: "SalesTrackingCategories"}
    SalesTrackingCategory[] salesTrackingCategories?;
    # Store certain address types for a contact – see address types
    @jsondata:Name {value: "Addresses"}
    Address[] addresses?;
    # The default sales account code for contacts
    @jsondata:Name {value: "SalesDefaultAccountCode"}
    string salesDefaultAccountCode?;
    # true or false – Boolean that describes if a contact that has any AP  invoices entered against them. Cannot be set via PUT or POST – it is automatically set when an accounts payable invoice is generated against this contact
    @jsondata:Name {value: "IsSupplier"}
    boolean isSupplier?;
    # Company registration number (max length = 50)
    @jsondata:Name {value: "CompanyNumber"}
    string companyNumber?;
    # Store certain phone types for a contact – see phone types
    @jsondata:Name {value: "Phones"}
    Phone[] phones?;
    # The tax type from TaxRates
    @jsondata:Name {value: "AccountsReceivableTaxType"}
    string accountsReceivableTaxType?;
    # The tax type from TaxRates
    @jsondata:Name {value: "AccountsPayableTaxType"}
    string accountsPayableTaxType?;
    # Bank account number of contact
    @jsondata:Name {value: "BankAccountDetails"}
    string bankAccountDetails?;
    # The default purchases account code for contacts
    @jsondata:Name {value: "PurchasesDefaultAccountCode"}
    string purchasesDefaultAccountCode?;
    # Batch payment details of the contact
    @jsondata:Name {value: "BatchPayments"}
    BatchPaymentDetails batchPayments?;
    # This can be updated via the API only i.e. This field is read only on the Xero contact screen, used to identify contacts in external systems (max length = 50). If the Contact Number is used, this is displayed as Contact Code in the Contacts UI in Xero
    @jsondata:Name {value: "ContactNumber"}
    string contactNumber?;
    # Tax number of contact – this is also known as the ABN (Australia), GST Number (New Zealand), VAT Number (UK) or Tax ID Number (US and global) in the Xero UI depending on which regionalized version of Xero you are using (max length = 50)
    @jsondata:Name {value: "TaxNumber"}
    string taxNumber?;
    # Default branding theme of the contact
    @jsondata:Name {value: "BrandingTheme"}
    BrandingTheme brandingTheme?;
    # Displays which contact groups a contact is included in
    @jsondata:Name {value: "ContactGroups"}
    ContactGroup[] contactGroups?;
    # true or false – Boolean that describes if a contact has any AR invoices entered against them. Cannot be set via PUT or POST – it is automatically set when an accounts receivable invoice is generated against this contact
    @jsondata:Name {value: "IsCustomer"}
    boolean isCustomer?;
    # Status of object
    @jsondata:Name {value: "StatusAttributeString"}
    string statusAttributeString?;
    # Default currency of the contact
    @jsondata:Name {value: "DefaultCurrency"}
    CurrencyCode defaultCurrency?;
    # First name of contact person (max length = 255)
    @jsondata:Name {value: "FirstName"}
    string firstName?;
    # A boolean to indicate if a contact has an attachment
    @jsondata:Name {value: "HasAttachments"}
    boolean hasAttachments = false;
    # Accounts receivable and payable balances of the contact
    @jsondata:Name {value: "Balances"}
    Balances balances?;
    # Xero identifier
    @jsondata:Name {value: "ContactID"}
    string contactID?;
    # ID for the destination of a merged contact. Only returned when using paging or when fetching a contact by ContactId or ContactNumber
    @jsondata:Name {value: "MergedToContactID"}
    string mergedToContactID?;
    # Email address of contact person (umlauts not supported) (max length  = 255)
    @jsondata:Name {value: "EmailAddress"}
    string emailAddress?;
    # A user defined account number. This can be updated via the API and the Xero UI (max length = 50)
    @jsondata:Name {value: "AccountNumber"}
    string accountNumber?;
    # The default purchases tracking categories for contacts
    @jsondata:Name {value: "PurchasesTrackingCategories"}
    SalesTrackingCategory[] purchasesTrackingCategories?;
    # The name of the Tracking Option assigned to the contact under SalesTrackingCategories and PurchasesTrackingCategories
    @jsondata:Name {value: "TrackingCategoryOption"}
    string trackingCategoryOption?;
    # See contact persons
    @jsondata:Name {value: "ContactPersons"}
    ContactPerson[] contactPersons?;
    # Current status of a contact – see contact status types
    @jsondata:Name {value: "ContactStatus"}
    "ACTIVE"|"ARCHIVED"|"GDPRREQUEST" contactStatus?;
    # Last name of contact person (max length = 255)
    @jsondata:Name {value: "LastName"}
    string lastName?;
    # The name of the Tracking Category assigned to the contact under SalesTrackingCategories and PurchasesTrackingCategories
    @jsondata:Name {value: "TrackingCategoryName"}
    string trackingCategoryName?;
    # A boolean to indicate if a contact has an validation errors
    @jsondata:Name {value: "HasValidationErrors"}
    boolean hasValidationErrors = false;
    # Identifier of the regional type of tax number, such as US, UK, or other regional tax identifiers
    @jsondata:Name {value: "TaxNumberType"}
    "SSN"|"EIN"|"ITIN"|"ATIN" taxNumberType?;
    # Store XeroNetworkKey for contacts
    @jsondata:Name {value: "XeroNetworkKey"}
    string xeroNetworkKey?;
};

