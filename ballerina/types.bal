    # e.g. unitdp=4 – (Unit Decimal Places) You can opt in to use four decimal places for unit amounts
    int unitdp?;
};

public type AddressForOrganisation record {
    # max length = 500
    @jsondata:Name {value: "AddressLine3"}
    string addressLine3?;
    # max length = 500
    @jsondata:Name {value: "AddressLine2"}
    string addressLine2?;
    # max length = 500
    @jsondata:Name {value: "AddressLine1"}
    string addressLine1?;
    # max length = 255
    @jsondata:Name {value: "AttentionTo"}
    string attentionTo?;
    # max length = 500
    @jsondata:Name {value: "AddressLine4"}
    string addressLine4?;
    # max length = 255
    @jsondata:Name {value: "Region"}
    string region?;
    # max length = 50
    @jsondata:Name {value: "PostalCode"}
    string postalCode?;
    # max length = 50, [A-Z], [a-z] only
    @jsondata:Name {value: "Country"}
    string country?;
    # max length = 255
    @jsondata:Name {value: "City"}
    string city?;
    # define the type of address
    @jsondata:Name {value: "AddressType"}
    "POBOX"|"STREET"|"DELIVERY" addressType?;
};

public type Account record {
    # Accounts with a status of ACTIVE can be updated to ARCHIVED. See Account Status Codes
    @jsondata:Name {value: "Status"}
    "ACTIVE"|"ARCHIVED"|"DELETED" status?;
    # The Xero identifier for an account – specified as a string following  the endpoint name   e.g. /297c2dc5-cc47-4afd-8ec8-74990b8761e9
    @jsondata:Name {value: "AccountID"}
    string accountID?;
    # Description of the Account. Valid for all types of accounts except bank accounts (max length = 4000)
    @jsondata:Name {value: "Description"}
    string description?;
    # Last modified date UTC format
    @jsondata:Name {value: "UpdatedDateUTC"}
    string updatedDateUTC?;
    # Displays array of validation error messages from the API
    @jsondata:Name {value: "ValidationErrors"}
    ValidationError[] validationErrors?;
    # Boolean – describes whether account code is available for use with expense claims
    @jsondata:Name {value: "ShowInExpenseClaims"}
    boolean showInExpenseClaims?;
    # boolean to indicate if an account has an attachment (read only)
    @jsondata:Name {value: "HasAttachments"}
    boolean hasAttachments = false;
    # Customer defined alpha numeric account code e.g 200 or SALES (max length = 10)
    @jsondata:Name {value: "Code"}
    string code?;
    # Name of account (max length = 150)
    @jsondata:Name {value: "Name"}
    string name?;
    # Currency code of the account
    @jsondata:Name {value: "CurrencyCode"}
    CurrencyCode currencyCode?;
    # Shown if set
    @jsondata:Name {value: "ReportingCodeName"}
    string reportingCodeName?;
    # The tax type from taxRates
    @jsondata:Name {value: "TaxType"}
    string taxType?;
    # Boolean – describes whether account can have payments applied to it
    @jsondata:Name {value: "EnablePaymentsToAccount"}
    boolean enablePaymentsToAccount?;
    # Type of the account (for example BANK, REVENUE or EXPENSE)
    @jsondata:Name {value: "Type"}
    AccountType 'type?;
    # For bank accounts only. See Bank Account types
    @jsondata:Name {value: "BankAccountType"}
    "BANK"|"CREDITCARD"|"PAYPAL"|"NONE"|"" bankAccountType?;
    # Boolean – describes whether the account is shown in the watchlist widget on the dashboard
    @jsondata:Name {value: "AddToWatchlist"}
    boolean addToWatchlist?;
    # See Account Class Types
    @jsondata:Name {value: "Class"}
    "ASSET"|"EQUITY"|"EXPENSE"|"LIABILITY"|"REVENUE" 'class?;
    # For bank accounts only (Account Type BANK)
    @jsondata:Name {value: "BankAccountNumber"}
    string bankAccountNumber?;
    # Shown if set
    @jsondata:Name {value: "ReportingCode"}
    string reportingCode?;
    # If this is a system account then this element is returned. See System Account types. Note that non-system accounts may have this element set as either “” or null
    @jsondata:Name {value: "SystemAccount"}
    "DEBTORS"|"CREDITORS"|"BANKCURRENCYGAIN"|"GST"|"GSTONIMPORTS"|"HISTORICAL"|"REALISEDCURRENCYGAIN"|"RETAINEDEARNINGS"|"ROUNDING"|"TRACKINGTRANSFERS"|"UNPAIDEXPCLM"|"UNREALISEDCURRENCYGAIN"|"WAGEPAYABLES"|"CISASSETS"|"CISASSET"|"CISLABOUR"|"CISLABOUREXPENSE"|"CISLABOURINCOME"|"CISLIABILITY"|"CISMATERIALS"|"" systemAccount?;
};

# Represents the Headers record for the operation: getPrepayments
public type GetPrepaymentsHeaders record {
    # Only records created or modified since this timestamp will be returned
    @http:Header {name: "If-Modified-Since"}
    string ifModifiedSince?;
    # Xero identifier for Tenant
    @http:Header {name: "xero-tenant-id"}
    string xeroTenantId;
};

public type Invoice record {
    # See BrandingThemes
    @jsondata:Name {value: "BrandingThemeID"}
    string brandingThemeID?;
    # The currency rate for a multicurrency invoice. If no rate is specified, the XE.com day rate is used. (max length = [18].[6])
    @jsondata:Name {value: "CurrencyRate"}
    decimal currencyRate?;
    # UTC timestamp of last update to the invoice
    @jsondata:Name {value: "UpdatedDateUTC"}
    string updatedDateUTC?;
    # Displays array of validation error messages from the API
    @jsondata:Name {value: "ValidationErrors"}
    ValidationError[] validationErrors?;
    # Sum of payments received for invoice
    @jsondata:Name {value: "AmountPaid"}
    decimal amountPaid?;
    # Sum of all credit notes, over-payments and pre-payments applied to invoice
    @jsondata:Name {value: "AmountCredited"}
    decimal amountCredited?;
    # See Payments
    @jsondata:Name {value: "Payments"}
    Payment[] payments?;
    # Details of credit notes that have been applied to an invoice
    @jsondata:Name {value: "CreditNotes"}
    CreditNote[] creditNotes?;
    # Total of invoice excluding taxes. Calculated automatically by Xero from the invoice's line items. Only for ACCPAY and ACCREC invoices, where this opt-in capability is enabled for your organisation, can SubTotal be supplied on write – on a SUBMITTED or AUTHORISED invoice supplied together with TotalTax and Total, it is validated against the calculated line item totals (see RoundingAmount); it is ignored in all other cases. This write behaviour, and the returned value reflecting it, only applies to the Create and Update endpoints (POST/PUT) and to retrieving a single invoice by ID (GET by ID) – it does not apply when listing invoices (GET)
    @jsondata:Name {value: "SubTotal"}
    decimal subTotal?;
    # Displays array of attachments from the API
    @jsondata:Name {value: "Attachments"}
    Attachment[] attachments?;
    # URL link to a source document – shown as “Go to [appName]” in the Xero app
    @jsondata:Name {value: "Url"}
    string url?;
    # Currency code of the invoice
    @jsondata:Name {value: "CurrencyCode"}
    CurrencyCode currencyCode?;
    # UTC ISO-8601 formatted timestamp of last update to the invoice
    @jsondata:Name {value: "UpdatedDateUTCString"}
    string updatedDateUTCString?;
    # Shown on bills (Accounts Payable) when this has been set
    @jsondata:Name {value: "PlannedPaymentDate"}
    string plannedPaymentDate?;
    # An array of addresses used to auto calculate sales tax
    @jsondata:Name {value: "InvoiceAddresses"}
    InvoiceAddress[] invoiceAddresses?;
    # Total tax on invoice. Calculated automatically by Xero from the invoice's line items. Only for ACCPAY and ACCREC invoices, where this opt-in capability is enabled for your organisation, can TotalTax be supplied on write – on a SUBMITTED or AUTHORISED invoice supplied together with SubTotal and Total, it is validated against the calculated line item totals (see RoundingAmount); it is ignored in all other cases. This write behaviour, and the returned value reflecting it, only applies to the Create and Update endpoints (POST/PUT) and to retrieving a single invoice by ID (GET by ID) – it does not apply when listing invoices (GET)
    @jsondata:Name {value: "TotalTax"}
    decimal totalTax?;
    # ACCREC – Unique alpha numeric code identifying invoice (when missing will auto-generate from your Organisation Invoice Settings) (max length = 255)
    @jsondata:Name {value: "InvoiceNumber"}
    string invoiceNumber?;
    # Date invoice is due – YYYY-MM-DD
    @jsondata:Name {value: "DueDate"}
    string dueDate?;
    # See Invoice Status Codes
    @jsondata:Name {value: "Status"}
    "DRAFT"|"SUBMITTED"|"DELETED"|"AUTHORISED"|"PAID"|"VOIDED" status?;
    # See LineItems
    @jsondata:Name {value: "LineItems"}
    LineItem[] lineItems?;
    # Amount remaining to be paid on invoice
    @jsondata:Name {value: "AmountDue"}
    decimal amountDue?;
    # A string to indicate if a invoice status
    @jsondata:Name {value: "StatusAttributeString"}
    string statusAttributeString?;
    # ACCREC only – additional reference number
    @jsondata:Name {value: "Reference"}
    string reference?;
    # CIS Deduction rate for the organisation
    @jsondata:Name {value: "CISRate"}
    decimal cISRate?;
    # boolean to indicate if an invoice has an attachment
    @jsondata:Name {value: "HasAttachments"}
    boolean hasAttachments = false;
    # See Prepayments
    @jsondata:Name {value: "Prepayments"}
    Prepayment[] prepayments?;
    # Boolean to set whether the invoice in the Xero app should be marked as “sent”. This can be set only on invoices that have been approved
    @jsondata:Name {value: "SentToContact"}
    boolean sentToContact?;
    # The total amount as originally entered for the invoice, before any RoundingAmount adjustment is applied. Only applies to ACCPAY and ACCREC invoices, and only if this opt-in capability has been enabled for your organisation. Can only be set while the invoice is DRAFT; once the invoice is no longer DRAFT this reflects Total. This field is only settable and only returned via the Create and Update endpoints (POST/PUT) and when retrieving a single invoice by ID (GET by ID) – it is not returned when listing invoices (GET)
    @jsondata:Name {value: "EnteredTotal"}
    decimal enteredTotal?;
    # Xero generated unique identifier for invoice
    @jsondata:Name {value: "InvoiceID"}
    string invoiceID?;
    # Date invoice was issued – YYYY-MM-DD. If the Date element is not specified it will default to the current date based on the timezone setting of the organisation
    @jsondata:Name {value: "Date"}
    string date?;
    # Contact associated with the invoice
    @jsondata:Name {value: "Contact"}
    Contact contact?;
    # Whether line amounts of the invoice are tax exclusive, tax inclusive or have no tax
    @jsondata:Name {value: "LineAmountTypes"}
    LineAmountTypes lineAmountTypes?;
    # CIS deduction for UK contractors
    @jsondata:Name {value: "CISDeduction"}
    decimal cISDeduction?;
    # Shown on sales invoices (Accounts Receivable) when this has been set
    @jsondata:Name {value: "ExpectedPaymentDate"}
    string expectedPaymentDate?;
    # See Invoice Types
    @jsondata:Name {value: "Type"}
    "ACCPAY"|"ACCPAYCREDIT"|"APOVERPAYMENT"|"APPREPAYMENT"|"ACCREC"|"ACCRECCREDIT"|"AROVERPAYMENT"|"ARPREPAYMENT" 'type?;
    # The date the invoice was fully paid. Only returned on fully paid invoices
    @jsondata:Name {value: "FullyPaidOnDate"}
    string fullyPaidOnDate?;
    # Total of Invoice tax inclusive (i.e. SubTotal + TotalTax + RoundingAmount). Calculated automatically by Xero from the invoice's line items. Only for ACCPAY and ACCREC invoices, where this opt-in capability is enabled for your organisation, can Total be supplied on write – on a SUBMITTED or AUTHORISED invoice supplied together with SubTotal and TotalTax, it is validated against the calculated line item totals plus RoundingAmount; in all other cases this will be ignored if it does not equal the sum of the LineAmounts. This write behaviour, and the returned value reflecting it, only applies to the Create and Update endpoints (POST/PUT) and to retrieving a single invoice by ID (GET by ID) – it does not apply when listing invoices (GET)
    @jsondata:Name {value: "Total"}
    decimal total?;
    # See Overpayments
    @jsondata:Name {value: "Overpayments"}
    Overpayment[] overpayments?;
    # Xero generated unique identifier for repeating invoices
    @jsondata:Name {value: "RepeatingInvoiceID"}
    string repeatingInvoiceID?;
    # boolean to indicate if an invoice has a discount
    @jsondata:Name {value: "IsDiscounted"}
    boolean isDiscounted?;
    # A boolean to indicate if a invoice has an validation errors
    @jsondata:Name {value: "HasErrors"}
    boolean hasErrors = false;
    # Displays array of warning messages from the API
    @jsondata:Name {value: "Warnings"}
    ValidationError[] warnings?;
    # Total of discounts applied on the invoice line items
    @jsondata:Name {value: "TotalDiscount"}
    decimal totalDiscount?;
    # An optional rounding adjustment added to SubTotal + TotalTax to give Total (i.e. Total = SubTotal + TotalTax + RoundingAmount). Only applies to ACCPAY and ACCREC invoices, and only if this opt-in capability has been enabled for your organisation. Not validated while the invoice is DRAFT. For SUBMITTED and AUTHORISED invoices, RoundingAmount is only applied when SubTotal, TotalTax and Total are all supplied together, and must be between -0.10 and 0.10 – values outside this range are rejected with a validation error (on DRAFT invoices, an out-of-range value is ignored instead). This field is only settable and only returned via the Create and Update endpoints (POST/PUT) and when retrieving a single invoice by ID (GET by ID) – it is not returned when listing invoices (GET)
    @jsondata:Name {value: "RoundingAmount"}
    decimal roundingAmount?;
};

