public type Quote record {
    # Status of the quote
    @jsondata:Name {value: "Status"}
    QuoteStatusCodes status?;
    # See LineItems
    @jsondata:Name {value: "LineItems"}
    LineItem[] lineItems?;
    # Date the quote expires – YYYY-MM-DD
    @jsondata:Name {value: "ExpiryDate"}
    string expiryDate?;
    # See BrandingThemes
    @jsondata:Name {value: "BrandingThemeID"}
    string brandingThemeID?;
    # A string to indicate if a invoice status
    @jsondata:Name {value: "StatusAttributeString"}
    string statusAttributeString?;
    # The currency rate for a multicurrency quote
    @jsondata:Name {value: "CurrencyRate"}
    decimal currencyRate?;
    # Last modified date UTC format
    @jsondata:Name {value: "UpdatedDateUTC"}
    string updatedDateUTC?;
    # QuoteID GUID is automatically generated and is returned after create or GET
    @jsondata:Name {value: "QuoteID"}
    string quoteID?;
    # Displays array of validation error messages from the API
    @jsondata:Name {value: "ValidationErrors"}
    ValidationError[] validationErrors?;
    # Additional reference number
    @jsondata:Name {value: "Reference"}
    string reference?;
    # Terms of the quote
    @jsondata:Name {value: "Terms"}
    string terms?;
    # Title text for the quote
    @jsondata:Name {value: "Title"}
    string title?;
    # Total of quote excluding taxes
    @jsondata:Name {value: "SubTotal"}
    decimal subTotal?;
    # Date quote was issued – YYYY-MM-DD. If the Date element is not specified it will default to the current date based on the timezone setting of the organisation
    @jsondata:Name {value: "Date"}
    string date?;
    # Contact associated with the quote
    @jsondata:Name {value: "Contact"}
    Contact contact?;
    # Whether line amounts of the quote are tax exclusive, tax inclusive or have no tax
    @jsondata:Name {value: "LineAmountTypes"}
    QuoteLineAmountTypes lineAmountTypes?;
    # Currency code of the quote
    @jsondata:Name {value: "CurrencyCode"}
    CurrencyCode currencyCode?;
    # Unique alpha numeric code identifying a quote (Max Length = 255)
    @jsondata:Name {value: "QuoteNumber"}
    string quoteNumber?;
    # Total tax on quote
    @jsondata:Name {value: "TotalTax"}
    decimal totalTax?;
    # Date the quote was issued (YYYY-MM-DD)
    @jsondata:Name {value: "DateString"}
    string dateString?;
    # Total of Quote tax inclusive (i.e. SubTotal + TotalTax). This will be ignored if it doesn’t equal the sum of the LineAmounts
    @jsondata:Name {value: "Total"}
    decimal total?;
    # Summary text for the quote
    @jsondata:Name {value: "Summary"}
    string summary?;
    # Date the quote expires – YYYY-MM-DD
    @jsondata:Name {value: "ExpiryDateString"}
    string expiryDateString?;
    # Total of discounts applied on the quote line items
    @jsondata:Name {value: "TotalDiscount"}
    decimal totalDiscount?;
};

