public type BankTransaction record {
    # See Bank Transaction Status Codes
    @jsondata:Name {value: "Status"}
    "AUTHORISED"|"DELETED"|"VOIDED" status?;
    # See LineItems
    @jsondata:Name {value: "LineItems"}
    LineItem[] lineItems;
    # A string to indicate if a invoice status
    @jsondata:Name {value: "StatusAttributeString"}
    string statusAttributeString?;
    # Exchange rate to base currency when money is spent or received. e.g.0.7500 Only used for bank transactions in non base currency. If this isn’t specified for non base currency accounts then either the user-defined rate (preference) or the XE.com day rate will be used. Setting currency is only supported on overpayments
    @jsondata:Name {value: "CurrencyRate"}
    decimal currencyRate?;
    # Last modified date UTC format
    @jsondata:Name {value: "UpdatedDateUTC"}
    string updatedDateUTC?;
    # Displays array of validation error messages from the API
    @jsondata:Name {value: "ValidationErrors"}
    ValidationError[] validationErrors?;
    # Reference for the transaction. Only supported for SPEND and RECEIVE transactions
    @jsondata:Name {value: "Reference"}
    string reference?;
    # Boolean to indicate if a bank transaction has an attachment
    @jsondata:Name {value: "HasAttachments"}
    boolean hasAttachments = false;
    # Bank account of the transaction
    @jsondata:Name {value: "BankAccount"}
    Account bankAccount;
    # Boolean to show if transaction is reconciled
    @jsondata:Name {value: "IsReconciled"}
    boolean isReconciled?;
    # Total of bank transaction excluding taxes
    @jsondata:Name {value: "SubTotal"}
    decimal subTotal?;
    # Date of transaction – YYYY-MM-DD
    @jsondata:Name {value: "Date"}
    string date?;
    # URL link to a source document – shown as “Go to App Name”
    @jsondata:Name {value: "Url"}
    string url?;
    # Contact associated with the bank transaction
    @jsondata:Name {value: "Contact"}
    Contact contact?;
    # Whether line amounts of the bank transaction are tax exclusive, tax inclusive or have no tax
    @jsondata:Name {value: "LineAmountTypes"}
    LineAmountTypes lineAmountTypes?;
    # Currency code of the bank transaction
    @jsondata:Name {value: "CurrencyCode"}
    CurrencyCode currencyCode?;
    # See Bank Transaction Types
    @jsondata:Name {value: "Type"}
    "RECEIVE"|"RECEIVE-OVERPAYMENT"|"RECEIVE-PREPAYMENT"|"SPEND"|"SPEND-OVERPAYMENT"|"SPEND-PREPAYMENT"|"RECEIVE-TRANSFER"|"SPEND-TRANSFER" 'type;
    # Xero generated unique identifier for a Prepayment. This will be returned on BankTransactions with a Type of SPEND-PREPAYMENT or RECEIVE-PREPAYMENT
    @jsondata:Name {value: "PrepaymentID"}
    string prepaymentID?;
    # Total tax on bank transaction
    @jsondata:Name {value: "TotalTax"}
    decimal totalTax?;
    # Total of bank transaction tax inclusive
    @jsondata:Name {value: "Total"}
    decimal total?;
    # Xero generated unique identifier for an Overpayment. This will be returned on BankTransactions with a Type of SPEND-OVERPAYMENT or RECEIVE-OVERPAYMENT
    @jsondata:Name {value: "OverpaymentID"}
    string overpaymentID?;
    # Xero generated unique identifier for bank transaction
    @jsondata:Name {value: "BankTransactionID"}
    string bankTransactionID?;
};

