public type CreditNote record {
    # See Allocations
    @jsondata:Name {value: "Allocations"}
    Allocation[] allocations?;
    # See BrandingThemes
    @jsondata:Name {value: "BrandingThemeID"}
    string brandingThemeID?;
    # UTC timestamp of last update to the credit note
    @jsondata:Name {value: "UpdatedDateUTC"}
    string updatedDateUTC?;
    # The currency rate for a multicurrency invoice. If no rate is specified, the XE.com day rate is used
    @jsondata:Name {value: "CurrencyRate"}
    decimal currencyRate?;
    # Displays array of validation error messages from the API
    @jsondata:Name {value: "ValidationErrors"}
    ValidationError[] validationErrors?;
    # See Payments
    @jsondata:Name {value: "Payments"}
    Payment[] payments?;
    # The subtotal of the credit note excluding taxes
    @jsondata:Name {value: "SubTotal"}
    decimal subTotal?;
    # UTC ISO-8601 formatted timestamp of last update to the credit note
    @jsondata:Name {value: "UpdatedDateUTCString"}
    string updatedDateUTCString?;
    # Currency code of the credit note
    @jsondata:Name {value: "CurrencyCode"}
    CurrencyCode currencyCode?;
    # An array of addresses used to auto calculate sales tax
    @jsondata:Name {value: "InvoiceAddresses"}
    InvoiceAddress[] invoiceAddresses?;
    # The remaining credit balance on the Credit Note
    @jsondata:Name {value: "RemainingCredit"}
    decimal remainingCredit?;
    # The total tax on the credit note
    @jsondata:Name {value: "TotalTax"}
    decimal totalTax?;
    # Date invoice is due – YYYY-MM-DD
    @jsondata:Name {value: "DueDate"}
    string dueDate?;
    # See Credit Note Status Codes
    @jsondata:Name {value: "Status"}
    "DRAFT"|"SUBMITTED"|"DELETED"|"AUTHORISED"|"PAID"|"VOIDED" status?;
    # See Invoice Line Items
    @jsondata:Name {value: "LineItems"}
    LineItem[] lineItems?;
    # Xero generated unique identifier
    @jsondata:Name {value: "CreditNoteID"}
    string creditNoteID?;
    # ACCRECCREDIT – Unique alpha numeric code identifying credit note (when missing will auto-generate from your Organisation Invoice Settings)
    @jsondata:Name {value: "CreditNoteNumber"}
    string creditNoteNumber?;
    # A string to indicate if a invoice status
    @jsondata:Name {value: "StatusAttributeString"}
    string statusAttributeString?;
    # CIS Deduction rate for the organisation
    @jsondata:Name {value: "CISRate"}
    decimal cISRate?;
    # ACCRECCREDIT only – additional reference number
    @jsondata:Name {value: "Reference"}
    string reference?;
    # boolean to indicate if a credit note has an attachment
    @jsondata:Name {value: "HasAttachments"}
    boolean hasAttachments = false;
    # The amount of applied to an invoice
    @jsondata:Name {value: "AppliedAmount"}
    decimal appliedAmount?;
    # Boolean to set whether the credit note in the Xero app should be marked as “sent”. This can be set only on credit notes that have been approved
    @jsondata:Name {value: "SentToContact"}
    boolean sentToContact?;
    # The date the credit note is issued YYYY-MM-DD. If the Date element is not specified then it will default to the current date based on the timezone setting of the organisation
    @jsondata:Name {value: "Date"}
    string date?;
    # Contact associated with the credit note
    @jsondata:Name {value: "Contact"}
    Contact contact?;
    # Whether line amounts of the credit note are tax exclusive, tax inclusive or have no tax
    @jsondata:Name {value: "LineAmountTypes"}
    LineAmountTypes lineAmountTypes?;
    # CIS deduction for UK contractors
    @jsondata:Name {value: "CISDeduction"}
    decimal cISDeduction?;
    # See Credit Note Types
    @jsondata:Name {value: "Type"}
    "ACCPAYCREDIT"|"ACCRECCREDIT" 'type?;
    # Date when credit note was fully paid(UTC format)
    @jsondata:Name {value: "FullyPaidOnDate"}
    string fullyPaidOnDate?;
    # The total of the Credit Note(subtotal + total tax)
    @jsondata:Name {value: "Total"}
    decimal total?;
    # A boolean to indicate if a credit note has an validation errors
    @jsondata:Name {value: "HasErrors"}
    boolean hasErrors = false;
    # Displays array of warning messages from the API
    @jsondata:Name {value: "Warnings"}
    ValidationError[] warnings?;
};

