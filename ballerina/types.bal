public type PurchaseOrder record {
    # See BrandingThemes
    @jsondata:Name {value: "BrandingThemeID"}
    string brandingThemeID?;
    # A free text feild for instructions (500 characters max)
    @jsondata:Name {value: "DeliveryInstructions"}
    string deliveryInstructions?;
    # The phone number for the person accepting the delivery
    @jsondata:Name {value: "Telephone"}
    string telephone?;
    # The currency rate for a multicurrency purchase order. If no rate is specified, the XE.com day rate is used
    @jsondata:Name {value: "CurrencyRate"}
    decimal currencyRate?;
    # Last modified date UTC format
    @jsondata:Name {value: "UpdatedDateUTC"}
    string updatedDateUTC?;
    # Displays array of validation error messages from the API
    @jsondata:Name {value: "ValidationErrors"}
    ValidationError[] validationErrors?;
    # The address the goods are to be delivered to
    @jsondata:Name {value: "DeliveryAddress"}
    string deliveryAddress?;
    # Date the goods are to be delivered – YYYY-MM-DD
    @jsondata:Name {value: "DeliveryDate"}
    string deliveryDate?;
    # Total of purchase order excluding taxes
    @jsondata:Name {value: "SubTotal"}
    decimal subTotal?;
    # Displays array of attachments from the API
    @jsondata:Name {value: "Attachments"}
    Attachment[] attachments?;
    # Currency code of the purchase order
    @jsondata:Name {value: "CurrencyCode"}
    CurrencyCode currencyCode?;
    # The person that the delivery is going to
    @jsondata:Name {value: "AttentionTo"}
    string attentionTo?;
    # Total tax on purchase order
    @jsondata:Name {value: "TotalTax"}
    decimal totalTax?;
    # Xero generated unique identifier for purchase order
    @jsondata:Name {value: "PurchaseOrderID"}
    string purchaseOrderID?;
    # See Purchase Order Status Codes
    @jsondata:Name {value: "Status"}
    "DRAFT"|"SUBMITTED"|"AUTHORISED"|"BILLED"|"DELETED" status?;
    # See LineItems
    @jsondata:Name {value: "LineItems"}
    LineItem[] lineItems?;
    # The date the goods are expected to arrive
    @jsondata:Name {value: "ExpectedArrivalDate"}
    string expectedArrivalDate?;
    # Unique alpha numeric code identifying purchase order (when missing will auto-generate from your Organisation Invoice Settings)
    @jsondata:Name {value: "PurchaseOrderNumber"}
    string purchaseOrderNumber?;
    # A string to indicate if a invoice status
    @jsondata:Name {value: "StatusAttributeString"}
    string statusAttributeString?;
    # Additional reference number
    @jsondata:Name {value: "Reference"}
    string reference?;
    # boolean to indicate if a purchase order has an attachment
    @jsondata:Name {value: "HasAttachments"}
    boolean hasAttachments = false;
    # Boolean to set whether the purchase order should be marked as “sent”. This can be set only on purchase orders that have been approved or billed
    @jsondata:Name {value: "SentToContact"}
    boolean sentToContact?;
    # Date purchase order was issued – YYYY-MM-DD. If the Date element is not specified then it will default to the current date based on the timezone setting of the organisation
    @jsondata:Name {value: "Date"}
    string date?;
    # Contact associated with the purchase order
    @jsondata:Name {value: "Contact"}
    Contact contact?;
    # Whether line amounts of the purchase order are tax exclusive, tax inclusive or have no tax
    @jsondata:Name {value: "LineAmountTypes"}
    LineAmountTypes lineAmountTypes?;
    # Total of Purchase Order tax inclusive (i.e. SubTotal + TotalTax)
    @jsondata:Name {value: "Total"}
    decimal total?;
    # Displays array of warning messages from the API
    @jsondata:Name {value: "Warnings"}
    ValidationError[] warnings?;
    # Total of discounts applied on the purchase order line items
    @jsondata:Name {value: "TotalDiscount"}
    decimal totalDiscount?;
};

