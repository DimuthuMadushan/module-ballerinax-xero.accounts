public type BankTransfer record {
    # AUTHORISED or DELETED (read-only). New bank transfers will have a status of AUTHORISED
    @jsondata:Name {value: "Status"}
    "AUTHORISED"|"DELETED" status?;
    # The currency rate
    @jsondata:Name {value: "CurrencyRate"}
    decimal currencyRate?;
    # Displays array of validation error messages from the API
    @jsondata:Name {value: "ValidationErrors"}
    ValidationError[] validationErrors?;
    # Reference for the transactions
    @jsondata:Name {value: "Reference"}
    string reference?;
    # Boolean to indicate if a Bank Transfer has an attachment
    @jsondata:Name {value: "HasAttachments"}
    boolean hasAttachments = false;
    # amount of the transaction
    @jsondata:Name {value: "Amount"}
    decimal amount;
    # The Bank Transaction ID for the destination account
    @jsondata:Name {value: "ToBankTransactionID"}
    string toBankTransactionID?;
    # Optional Tracking Category for the destination account – see Tracking. A bank transfer can have a maximum of 2 tracking categories per account
    @jsondata:Name {value: "ToTracking"}
    TrackingReference[] toTracking?;
    # The date of the Transfer YYYY-MM-DD
    @jsondata:Name {value: "Date"}
    string date?;
    # UTC timestamp of creation date of bank transfer
    @jsondata:Name {value: "CreatedDateUTC"}
    string createdDateUTC?;
    # The Bank Transaction boolean to show if it is reconciled for the source account
    @jsondata:Name {value: "FromIsReconciled"}
    boolean fromIsReconciled = false;
    # Bank account the money is transferred from
    @jsondata:Name {value: "FromBankAccount"}
    Account fromBankAccount;
    # Bank account the money is transferred to
    @jsondata:Name {value: "ToBankAccount"}
    Account toBankAccount;
    # The Bank Transaction ID for the source account
    @jsondata:Name {value: "FromBankTransactionID"}
    string fromBankTransactionID?;
    # The identifier of the Bank Transfer
    @jsondata:Name {value: "BankTransferID"}
    string bankTransferID?;
    # The Bank Transaction boolean to show if it is reconciled for the destination account
    @jsondata:Name {value: "ToIsReconciled"}
    boolean toIsReconciled = false;
    # Optional Tracking Category for the source account – see Tracking. A bank transfer can have a maximum of 2 tracking categories per account
    @jsondata:Name {value: "FromTracking"}
    TrackingReference[] fromTracking?;
};

