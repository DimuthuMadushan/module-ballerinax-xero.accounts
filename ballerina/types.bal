public type Payment record {
    # Account the payment is made from or to
    @jsondata:Name {value: "Account"}
    Account account?;
    # Invoice the payment is applied to
    @jsondata:Name {value: "Invoice"}
    Invoice invoice?;
    # Exchange rate when payment is received. Only used for non base currency invoices and credit notes e.g. 0.7500
    @jsondata:Name {value: "CurrencyRate"}
    decimal currencyRate?;
    # UTC timestamp of last update to the payment
    @jsondata:Name {value: "UpdatedDateUTC"}
    string updatedDateUTC?;
    # Present if the payment was created as part of a batch
    @jsondata:Name {value: "BatchPaymentID"}
    string batchPaymentID?;
    # Displays array of validation error messages from the API
    @jsondata:Name {value: "ValidationErrors"}
    ValidationError[] validationErrors?;
    # Credit note the payment is applied to
    @jsondata:Name {value: "CreditNote"}
    CreditNote creditNote?;
    # The Xero identifier for an Payment e.g. 297c2dc5-cc47-4afd-8ec8-74990b8761e9
    @jsondata:Name {value: "PaymentID"}
    string paymentID?;
    # Batch payment the payment belongs to
    @jsondata:Name {value: "BatchPayment"}
    BatchPayment batchPayment?;
    # UTC ISO-8601 formatted timestamp of last update to the payment
    @jsondata:Name {value: "UpdatedDateUTCString"}
    string updatedDateUTCString?;
    # The suppliers bank account number the payment is being made to
    @jsondata:Name {value: "Particulars"}
    string particulars?;
    # See Payment Types
    @jsondata:Name {value: "PaymentType"}
    "ACCRECPAYMENT"|"ACCPAYPAYMENT"|"ARCREDITPAYMENT"|"APCREDITPAYMENT"|"AROVERPAYMENTPAYMENT"|"ARPREPAYMENTPAYMENT"|"APPREPAYMENTPAYMENT"|"APOVERPAYMENTPAYMENT" paymentType?;
    # A boolean to indicate if a contact has an validation errors
    @jsondata:Name {value: "HasAccount"}
    boolean hasAccount = false;
    # Number of invoice or credit note you are applying payment to e.g.INV-4003
    @jsondata:Name {value: "InvoiceNumber"}
    string invoiceNumber?;
    # Overpayment the payment is applied to
    @jsondata:Name {value: "Overpayment"}
    Overpayment overpayment?;
    # The status of the payment
    @jsondata:Name {value: "Status"}
    "AUTHORISED"|"DELETED" status?;
    # Number of invoice or credit note you are applying payment to e.g. INV-4003
    @jsondata:Name {value: "CreditNoteNumber"}
    string creditNoteNumber?;
    # A string to indicate if a invoice status
    @jsondata:Name {value: "StatusAttributeString"}
    string statusAttributeString?;
    # An optional description for the payment e.g. Direct Debit
    @jsondata:Name {value: "Reference"}
    string reference?;
    # The amount of the payment. Must be less than or equal to the outstanding amount owing on the invoice e.g. 200.00
    @jsondata:Name {value: "Amount"}
    decimal amount?;
    # The amount of the payment in the currency of the bank account
    @jsondata:Name {value: "BankAmount"}
    decimal bankAmount?;
    # An optional parameter for the payment. A boolean indicating whether you would like the payment to be created as reconciled when using PUT, or whether a payment has been reconciled when using GET
    @jsondata:Name {value: "IsReconciled"}
    boolean isReconciled?;
    # Code of account you are using to make the payment e.g. 001 (note- not all accounts have a code value)
    @jsondata:Name {value: "Code"}
    string code?;
    # Date the payment is being made (YYYY-MM-DD) e.g. 2009-09-06
    @jsondata:Name {value: "Date"}
    string date?;
    # The information to appear on the supplier's bank account
    @jsondata:Name {value: "Details"}
    string details?;
    # Prepayment the payment is applied to
    @jsondata:Name {value: "Prepayment"}
    Prepayment prepayment?;
    # A boolean to indicate if a contact has an validation errors
    @jsondata:Name {value: "HasValidationErrors"}
    boolean hasValidationErrors = false;
    # Displays array of warning messages from the API
    @jsondata:Name {value: "Warnings"}
    ValidationError[] warnings?;
    # The suppliers bank account number the payment is being made to
    @jsondata:Name {value: "BankAccountNumber"}
    string bankAccountNumber?;
};

