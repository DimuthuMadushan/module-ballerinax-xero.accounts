    @jsondata:Name {value: "Version"}
    "AU"|"NZ"|"GLOBAL"|"UK"|"US"|"AUONRAMP"|"NZONRAMP"|"GLOBALONRAMP"|"UKONRAMP"|"USONRAMP" version?;
    # Boolean to describe if organisation is registered with a local tax authority i.e. true, false
    @jsondata:Name {value: "PaysTax"}
    boolean paysTax?;
    # Shows for New Zealand, Australian and UK organisations
    @jsondata:Name {value: "RegistrationNumber"}
    string registrationNumber?;
    # Will be set to ACTIVE if you can connect to organisation via the Xero API
    @jsondata:Name {value: "OrganisationStatus"}
    string organisationStatus?;
    # Shown if set. Displays in the Xero UI as Tax File Number (AU), GST Number (NZ), VAT Number (UK) and Tax ID Number (US & Global)
    @jsondata:Name {value: "TaxNumber"}
    string taxNumber?;
    # Country code of the organisation
    @jsondata:Name {value: "CountryCode"}
    CountryCode countryCode?;
    # Organisation profile links for popular services such as Facebook,Twitter, GooglePlus and LinkedIn. You can also add link to your website here. Shown if Organisation settings  is updated in Xero. See ExternalLinks below
    @jsondata:Name {value: "ExternalLinks"}
    ExternalLink[] externalLinks?;
    # The default for LineAmountTypes on sales transactions
    @jsondata:Name {value: "DefaultSalesTax"}
    string defaultSalesTax?;
    # Organisation Entity Type
    @jsondata:Name {value: "OrganisationEntityType"}
    "ACCOUNTING_PRACTICE"|"COMPANY"|"CHARITY"|"CLUB_OR_SOCIETY"|"INDIVIDUAL"|"LOOK_THROUGH_COMPANY"|"NOT_FOR_PROFIT"|"PARTNERSHIP"|"S_CORPORATION"|"SELF_MANAGED_SUPERANNUATION_FUND"|"SOLE_TRADER"|"SUPERANNUATION_FUND"|"TRUST"|"PERSONAL"|"SINGLEMEMBERLLC"|"CCORPORATIONLLC"|"PARTNERSHIPLLC"|"SCORPORATIONLLC"|"LLC"|"NOTLLC"|"UNSPECIFIED" organisationEntityType?;
    # A unique identifier for the organisation. Potential uses
    @jsondata:Name {value: "ShortCode"}
    string shortCode?;
    # Organisation name shown on Reports
    @jsondata:Name {value: "LegalName"}
    string legalName?;
    # Shown if set. See lock dates
    @jsondata:Name {value: "PeriodLockDate"}
    string periodLockDate?;
    # Organisation Type
    @jsondata:Name {value: "OrganisationType"}
    "ACCOUNTING_PRACTICE"|"COMPANY"|"CHARITY"|"CLUB_OR_SOCIETY"|"INDIVIDUAL"|"LOOK_THROUGH_COMPANY"|"NOT_FOR_PROFIT"|"PARTNERSHIP"|"S_CORPORATION"|"SELF_MANAGED_SUPERANNUATION_FUND"|"SOLE_TRADER"|"SUPERANNUATION_FUND"|"TRUST"|"PERSONAL"|"SINGLEMEMBERLLC"|"CCORPORATIONLLC"|"PARTNERSHIPLLC"|"SCORPORATIONLLC"|"LLC"|"NOTLLC"|"UNSPECIFIED" organisationType?;
    # The accounting basis used for tax returns. See Sales Tax Basis
    @jsondata:Name {value: "SalesTaxBasis"}
    "PAYMENTS"|"INVOICE"|"NONE"|"CASH"|"ACCRUAL"|"FLATRATECASH"|"FLATRATEACCRUAL"|"ACCRUALS" salesTaxBasis?;
    # BUSINESS or PARTNER. Partner edition organisations are sold exclusively through accounting partners and have restricted functionality (e.g. no access to invoicing)
    @jsondata:Name {value: "Edition"}
    "BUSINESS"|"PARTNER" edition?;
    # Calendar Month e.g. 1-12
    @jsondata:Name {value: "FinancialYearEndMonth"}
    int financialYearEndMonth?;
    # Timestamp when the organisation was created in Xero
    @jsondata:Name {value: "CreatedDateUTC"}
    string createdDateUTC?;
    # Display a unique key used for Xero-to-Xero transactions
    @jsondata:Name {value: "APIKey"}
    string aPIKey?;
    # The frequency with which tax returns are processed. See Sales Tax Period
    @jsondata:Name {value: "SalesTaxPeriod"}
    "MONTHLY"|"QUARTERLY1"|"QUARTERLY2"|"QUARTERLY3"|"ANNUALLY"|"ONEMONTHS"|"TWOMONTHS"|"SIXMONTHS"|"1MONTHLY"|"2MONTHLY"|"3MONTHLY"|"6MONTHLY"|"QUARTERLY"|"YEARLY"|"NONE" salesTaxPeriod?;
    # Boolean to describe if organisation is a demo company
    @jsondata:Name {value: "IsDemoCompany"}
    boolean isDemoCompany?;
    # Calendar day e.g. 0-31
    @jsondata:Name {value: "FinancialYearEndDay"}
    int financialYearEndDay?;
    # Description of business type as defined in Organisation settings
    @jsondata:Name {value: "LineOfBusiness"}
    string lineOfBusiness?;
    # Base currency of the organisation
    @jsondata:Name {value: "BaseCurrency"}
    CurrencyCode baseCurrency?;
    # Organisation Classes describe which plan the Xero organisation is on (e.g. DEMO, TRIAL, PREMIUM)
    @jsondata:Name {value: "Class"}
    "DEMO"|"TRIAL"|"STARTER"|"STANDARD"|"PREMIUM"|"PREMIUM_20"|"PREMIUM_50"|"PREMIUM_100"|"LEDGER"|"GST_CASHBOOK"|"NON_GST_CASHBOOK"|"ULTIMATE"|"LITE"|"ULTIMATE_10"|"ULTIMATE_20"|"ULTIMATE_50"|"ULTIMATE_100"|"IGNITE"|"GROW"|"COMPREHENSIVE"|"SIMPLE"|"BASICLITE"|"ULTRA" 'class?;
};

