    decimal taxAmount?;
    # See Accounts
    @jsondata:Name {value: "AccountID"}
    string accountID?;
    # The description from the source transaction line item. Only returned if populated
    @jsondata:Name {value: "Description"}
    string description?;
    # Optional Tracking Category – see Tracking. Any JournalLine can have a maximum of 2 <TrackingCategory> elements
    @jsondata:Name {value: "TrackingCategories"}
    TrackingCategory[] trackingCategories?;
    # Net amount of journal line. This will be a positive value for a debit and negative for a credit
    @jsondata:Name {value: "NetAmount"}
    decimal netAmount?;
    # see TaxRates
    @jsondata:Name {value: "TaxName"}
    string taxName?;
    # See Accounts
    @jsondata:Name {value: "AccountCode"}
    string accountCode?;
    # Type of the account the journal line is posted to
    @jsondata:Name {value: "AccountType"}
    AccountType accountType?;
    # Gross amount of journal line (NetAmount + TaxAmount)
    @jsondata:Name {value: "GrossAmount"}
    decimal grossAmount?;
    # See AccountCodes
    @jsondata:Name {value: "AccountName"}
    string accountName?;
};

