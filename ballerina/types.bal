public type JournalLine record {
    # Xero identifier for Journal
    @jsondata:Name {value: "JournalLineID"}
    string journalLineID?;
    # The tax type from taxRates
    @jsondata:Name {value: "TaxType"}
    string taxType?;
    # Total tax on a journal line
