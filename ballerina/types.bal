# A summary of the accounts changes
public type ImportSummaryAccounts record {
    # The number of new accounts created
    @jsondata:Name {value: "New"}
    int:Signed32 'new?;
    # The number of locked accounts
    @jsondata:Name {value: "Locked"}
    int:Signed32 locked?;
    # The number of accounts updated
    @jsondata:Name {value: "Updated"}
    int:Signed32 updated?;
    # The number of accounts that had an error
    @jsondata:Name {value: "Errored"}
    int:Signed32 errored?;
    # The total number of accounts in the org
    @jsondata:Name {value: "Total"}
    int:Signed32 total?;
    # The number of new or updated accounts
    @jsondata:Name {value: "NewOrUpdated"}
    int:Signed32 newOrUpdated?;
    # The number of accounts deleted
    @jsondata:Name {value: "Deleted"}
    int:Signed32 deleted?;
    # Whether accounts are present in the organisation
    @jsondata:Name {value: "Present"}
    boolean present?;
    # The number of system accounts
    @jsondata:Name {value: "System"}
    int:Signed32 system?;
};

public type Item record {
    # Sales details for the item
    @jsondata:Name {value: "SalesDetails"}
    Purchase salesDetails?;
    # The sales description of the item (max length = 4000)
    @jsondata:Name {value: "Description"}
    string description?;
    # Status of object
    @jsondata:Name {value: "StatusAttributeString"}
    string statusAttributeString?;
    # Last modified date in UTC format
    @jsondata:Name {value: "UpdatedDateUTC"}
    string updatedDateUTC?;
    # Displays array of validation error messages from the API
    @jsondata:Name {value: "ValidationErrors"}
    ValidationError[] validationErrors?;
    # Boolean value, defaults to true. When IsPurchased is true the item is available for purchase transactions in the Xero UI. If IsPurchased is updated to false then PurchaseDescription and PurchaseDetails values will be nulled
    @jsondata:Name {value: "IsPurchased"}
    boolean isPurchased?;
    # True for items that are tracked as inventory. An item will be tracked as inventory if the InventoryAssetAccountCode and COGSAccountCode are set
    @jsondata:Name {value: "IsTrackedAsInventory"}
    boolean isTrackedAsInventory?;
    # The inventory asset account for the item. The account must be of type INVENTORY. The  COGSAccountCode in PurchaseDetails is also required to create a tracked item
    @jsondata:Name {value: "InventoryAssetAccountCode"}
    string inventoryAssetAccountCode?;
    # The quantity of the item on hand. This will be 0 if `QuantityOnBackOrder` is greater than 0
    @jsondata:Name {value: "QuantityOnHand"}
    decimal quantityOnHand?;
    # User defined item code (max length = 30)
    @jsondata:Name {value: "Code"}
    string code;
    # The purchase description of the item (max length = 4000)
    @jsondata:Name {value: "PurchaseDescription"}
    string purchaseDescription?;
    # The value of the item on hand. Calculated using average cost accounting
    @jsondata:Name {value: "TotalCostPool"}
    decimal totalCostPool?;
    # The Xero identifier for an Item
    @jsondata:Name {value: "ItemID"}
    string itemID?;
    # The name of the item (max length = 50)
    @jsondata:Name {value: "Name"}
    string name?;
    # Boolean value, defaults to true. When IsSold is true the item will be available on sales transactions in the Xero UI. If IsSold is updated to false then Description and SalesDetails values will be nulled
    @jsondata:Name {value: "IsSold"}
    boolean isSold?;
    # Purchase details for the item
    @jsondata:Name {value: "PurchaseDetails"}
    Purchase purchaseDetails?;
    # The quantity of the item on backorder. This will be 0 if `QuantityOnHand` is greater than 0
    @jsondata:Name {value: "QuantityOnBackOrder"}
    decimal quantityOnBackOrder?;
    # The quantity of the item available. This is equal to `QuantityOnHand` - `QuantityOnBackOrder`. This value will be negative if `QuantityOnBackOrder` is greater than 0
    @jsondata:Name {value: "QuantityAvailable"}
    decimal quantityAvailable?;
};

