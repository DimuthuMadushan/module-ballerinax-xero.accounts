    remote isolated function deleteTrackingOptions(string trackingCategoryID, string trackingOptionID, DeleteTrackingOptionsHeaders headers) returns TrackingOptions|error {
        string resourcePath = string `/TrackingCategories/${getEncodedUri(trackingCategoryID)}/Options/${getEncodedUri(trackingOptionID)}`;
        map<string|string[]> httpHeaders = http:getHeaderMap(headers);
        return self.clientEp->delete(resourcePath, headers = httpHeaders);
    }

    # Retrieves users
    #
    # + headers - Headers to be sent with the request 
    # + queries - Queries to be sent with the request 
    # + return - Success - return response of type Users array of all User 
    remote isolated function getUsers(GetUsersHeaders headers, *GetUsersQueries queries) returns Users|error {
        string resourcePath = string `/Users`;
        resourcePath = resourcePath + check getPathForQueryParam(queries);
        map<string|string[]> httpHeaders = http:getHeaderMap(headers);
        return self.clientEp->get(resourcePath, httpHeaders);
    }

    # Retrieves a specific user
    #
    # + userID - Unique identifier for a User
    # + headers - Headers to be sent with the request 
    # + return - Success - return response of type Users array of specified User 
    remote isolated function getUser(string userID, GetUserHeaders headers) returns Users|error {
        string resourcePath = string `/Users/${getEncodedUri(userID)}`;
        map<string|string[]> httpHeaders = http:getHeaderMap(headers);
        return self.clientEp->get(resourcePath, httpHeaders);
    }
}
